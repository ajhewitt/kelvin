<nav>
  <%= nav_link_to "Current list", madmin_root_path %>

  <% Madmin.menu.render do |item| %>
    <% if item.url %>
      <%= nav_link_to item.label, item.url, starts_with: item.url %>
    <% else %>
      <h4><%= item.label %></h4>
    <% end %>

    <% item.items.each do |item| %>
      <%= nav_link_to item.label, item.url, starts_with: item.url %>
    <% end %>
  <% end %>
</nav>

<footer>
  <%= link_to "Board", main_app.root_path, target: "_blank" %>
  <%= link_to "Users", madmin_users_path %>
  <%= button_to "Log out #{current_user.username}", main_app.login_path, method: :delete, class: "btn btn-secondary" %>
</footer>
