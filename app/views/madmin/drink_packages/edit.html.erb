<%= content_for :title, "#{@item.drink.name} on the #{@event.name} list" %>

<header class="header">
  <h1>
    <%= link_to @event.name, madmin_event_drink_packages_path(@event) %>
    /
    <%= @item.drink.name %>
  </h1>

  <div class="actions">
    <%= link_to "Edit the drink", edit_madmin_drink_path(@item.drink), class: "btn btn-secondary" %>
    <%= button_to "Take off the list", madmin_event_drink_package_path(@event, @item), method: :delete, class: "btn btn-danger",
          form: {data: {turbo_confirm: "Take #{@item.drink.name} off the #{@event.name} list?"}} %>
  </div>
</header>

<p class="list-event"><%= [@item.package, @item.drink.brand&.name || "House"].join(" · ") %></p>

<%= form_with model: @item, url: madmin_event_drink_package_path(@event, @item) do |form| %>
  <%= render "madmin/drink_packages/errors", item: @item %>

  <div class="form-group">
    <%= form.label :emoji %>
    <%= form.text_field :emoji, class: "form-input list-emoji" %>
  </div>

  <div class="form-group">
    <%= form.check_box :show_image %>
    <%= form.label :show_image, "Show the drink's image, if it has one" %>
  </div>

  <div class="form-group">
    <%= form.check_box :kicked %>
    <%= form.label :kicked, "Kicked: still on the board, crossed out" %>
  </div>

  <%= form.submit "Save", class: "btn btn-primary" %>
  <%= link_to "Cancel", madmin_event_drink_packages_path(@event), class: "btn" %>
<% end %>
