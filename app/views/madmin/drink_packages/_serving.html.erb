<%# The event's serving session, run from here along with the drinks with the same controls as the
    session's own page: its status with the start and stop buttons, and its settings, like the draft
    temperature, with the latest readings %>
<section class="list-serving">
  <div class="session-controls">
    <span class="session-label">Serving</span>
    <% if (serving = @event.serving_session) %>
      <%= render "madmin/sessions/status", record: serving %>
      <%= link_to SessionResource.display_name(serving), madmin_session_path(serving), class: "list-serving-session" %>
    <% elsif Configuration.serving %>
      <span>Not started</span>
      <%= button_to "Start", madmin_event_serving_path(@event), class: "btn btn-primary" %>
    <% else %>
      <span>Add a configuration with the slug "<%= Configuration::SERVING %>" to serve from</span>
    <% end %>
  </div>

  <% serving&.settings&.order(:id)&.each do |setting| %>
    <div class="session-controls">
      <%= render "madmin/sessions/setting", setting: setting %>
    </div>
  <% end %>
</section>
