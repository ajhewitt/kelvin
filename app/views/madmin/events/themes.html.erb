<%= content_for :title, "Themes for #{@record.name}" %>

<header class="header">
  <h1>
    <%= link_to "Events", madmin_events_path %>
    /
    <%= link_to @record.name, madmin_event_path(@record) %>
    /
    <span data-egg-taps>Themes</span>
  </h1>

  <div class="actions">
    <%= link_to "List", madmin_event_drink_packages_path(@record), class: "btn btn-secondary" %>
  </div>
</header>

<p class="list-event">Each preview is this event's board. The TV picks up a new theme within 15 seconds.</p>

<%# The gallery's groups, the easter eggs hidden at the end of the last %>
<% Event::THEME_GROUPS.each_with_index do |(group, themes), index| %>
  <h2 class="theme-group"><%= group %></h2>
  <div class="theme-gallery">
    <% cards = (index == Event::THEME_GROUPS.size - 1) ? themes.merge(Event::EASTER_EGGS) : themes %>
    <% cards.each do |theme, description| %>
      <%= render "theme_card", theme: theme, description: description %>
    <% end %>
  </div>
<% end %>

<%# The easter eggs come out with the Konami code on a keyboard, or five quick taps on the page's title.
    The listeners go on the document once, as Turbo keeps it from page to page, and found eggs hide again
    before Turbo keeps a copy of the page to show on the way back %>
<script>
  if (!window.themeEggListeners) {
    window.themeEggListeners = true

    const reveal = () => {
      const eggs = document.querySelectorAll(".theme-card--egg[hidden]")
      eggs.forEach((card) => { card.hidden = false; card.dataset.found = "" })
      eggs[0]?.scrollIntoView({ behavior: "smooth", block: "center" })
    }

    document.addEventListener("turbo:before-cache", () => {
      document.querySelectorAll(".theme-card--egg[data-found]").forEach((card) => { card.hidden = true; delete card.dataset.found })
    })

    const konami = "arrowup arrowup arrowdown arrowdown arrowleft arrowright arrowleft arrowright b a"
    let keys = []
    document.addEventListener("keydown", (event) => {
      keys = [...keys, event.key.toLowerCase()].slice(-10)
      if (keys.join(" ") === konami) reveal()
    })

    let taps = []
    document.addEventListener("click", (event) => {
      if (!event.target.closest("[data-egg-taps]")) return
      taps = [...taps.filter((time) => event.timeStamp - time < 2000), event.timeStamp]
      if (taps.length === 5) reveal()
    })
  }
</script>
