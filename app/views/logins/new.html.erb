<main class="login">
  <h1 class="login-title">The Ludlow Park</h1>

  <% unless User.exists? %>
    <div class="alert alert-notice">There are no logins yet. Add one on the server with <code>bin/rails users:create</code></div>
  <% end %>
  <% if alert %>
    <div class="alert alert-danger"><%= alert %></div>
  <% end %>
  <% if notice %>
    <div class="alert alert-notice"><%= notice %></div>
  <% end %>

  <%= form_with url: login_path do |form| %>
    <div class="form-group">
      <%= form.label :username %>
      <%= form.text_field :username, value: params[:username], required: true, autofocus: true,
            autocomplete: "username", autocapitalize: "none", spellcheck: false, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", class: "form-input" %>
    </div>

    <%= form.submit "Log in", class: "btn btn-primary" %>
  <% end %>
</main>
